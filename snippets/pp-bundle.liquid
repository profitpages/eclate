{%- comment -%}
  Bought together (Profit Pages add-on), in Éclaté's "routine" style.
  Data: product.metafields.profitpages.bundle (discount) + .bundle_products (the
  companions, as product references). Shows only while the plan is active.
  Behavior (adding the set + its discount) comes from assets/pp-addons.js.
  Usage: {% render 'pp-bundle', product: product, variant: current_variant, heading: block.settings.heading %}
{%- endcomment -%}
{%- liquid
  assign addons = shop.metafields.profitpages.addons.value
  assign offer = product.metafields.profitpages.bundle.value
  assign companions = product.metafields.profitpages.bundle_products.value
-%}
{%- if addons.active and offer and companions.size > 0 -%}
  {%- liquid
    assign total = variant.price
    for c in companions
      assign total = total | plus: c.selected_or_first_available_variant.price
    endfor
    assign value = offer.discountValue | times: 1
    if offer.discountType == 'fixed'
      assign off = value | times: 100 | round
    else
      assign off = total | times: value | divided_by: 100 | round
    endif
    assign pay = total | minus: off
  -%}
  <div class="pp-bundle panel-card" data-pp-bundle data-handle="{{ product.handle }}">
    <div class="pp-bundle__head">
      {%- if heading == blank -%}{%- assign heading = 'addons.bundle_kicker' | t -%}{%- endif -%}
      <p class="kicker">{{ heading | escape }}</p>
      {%- if off > 0 -%}
        <span class="badge badge--sale">
          {%- if offer.discountType == 'fixed' -%}{%- assign save_label = off | money_without_trailing_zeros -%}{%- else -%}{%- assign save_label = value | append: '%' -%}{%- endif -%}
          {{ 'addons.bundle_save' | t: amount: save_label }}
        </span>
      {%- endif -%}
    </div>
    <ul class="pp-bundle__items" role="list">
      <li class="pp-bundle__item" data-pp-bundle-row>
        <input class="visually-hidden" type="checkbox" data-pp-bundle-item value="{{ variant.id }}" checked tabindex="-1" aria-hidden="true">
        <span class="pp-bundle__lock" aria-hidden="true">{%- render 'icon', name: 'check', size: 14 -%}</span>
        <span class="pp-bundle__thumb">{%- if variant.featured_image or product.featured_image -%}{{ variant.featured_image | default: product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
        <span class="pp-bundle__name"><span class="pp-bundle__this">{{ 'addons.bundle_this' | t }}</span>{{ product.title | escape }}</span>
        <span class="pp-bundle__price">{{ variant.price | money }}</span>
      </li>
      {%- for c in companions -%}
        {%- assign cv = c.selected_or_first_available_variant -%}
        {%- assign item_id = 'PPB-' | append: product.id | append: '-' | append: forloop.index -%}
        <li class="pp-bundle__item" data-pp-bundle-row>
          <input class="pp-bundle__check" type="checkbox" id="{{ item_id }}" data-pp-bundle-item value="{{ cv.id }}" checked{% unless cv.available %} disabled{% endunless %}>
          <label class="pp-bundle__thumb" for="{{ item_id }}">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: c.featured_image.alt | escape }}{%- endif -%}</label>
          <span class="pp-bundle__name">
            <a href="{{ c.url }}">{{ c.title | escape }}</a>
            {%- if c.variants.size > 1 -%}
              <select class="pp-bundle__variant input" data-pp-bundle-variant aria-label="{{ 'products.choose_options_for' | t: title: c.title | escape }}">
                {%- for v in c.variants -%}<option value="{{ v.id }}"{% if v == cv %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }}</option>{%- endfor -%}
              </select>
            {%- endif -%}
          </span>
          <span class="pp-bundle__price">{{ cv.price | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
    <div class="pp-bundle__foot">
      <p class="pp-bundle__total">
        <span>{{ 'addons.bundle_total' | t }}</span>
        <strong>{{ pay | money }}</strong>
        {%- if off > 0 -%}<s class="muted">{{ total | money }}</s>{%- endif -%}
      </p>
      <button type="button" class="btn btn--accent btn--block" data-pp-bundle-add>
        {%- render 'icon', name: 'bag', size: 18 -%}<span>{{ 'addons.bundle_add' | t }}</span>
      </button>
    </div>
  </div>
{%- endif -%}

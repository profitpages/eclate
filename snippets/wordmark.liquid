{%- comment -%} Logo (or shop-name wordmark). Usage: {% render 'wordmark', inverse: false, tag: 'span' %} {%- endcomment -%}
{%- liquid
  assign logo_img = settings.logo
  if inverse and settings.logo_inverse != blank
    assign logo_img = settings.logo_inverse
  endif
-%}
<a class="wordmark" href="{{ routes.root_url }}">
  {%- if logo_img != blank -%}
    {%- assign logo_h = settings.logo_width | divided_by: logo_img.aspect_ratio | round -%}
    {{ logo_img | image_url: width: 600 | image_tag: width: settings.logo_width, height: logo_h, alt: shop.name, loading: 'eager', widths: '150, 300, 450, 600', class: 'wordmark__img' }}
  {%- else -%}
    <span class="wordmark__text">{%- if settings.wordmark_lowercase -%}{{ shop.name | downcase | escape }}{%- else -%}{{ shop.name | escape }}{%- endif -%}{%- if settings.wordmark_dot -%}<span class="wordmark__dot" aria-hidden="true">.</span>{%- endif -%}</span>
  {%- endif -%}
</a>

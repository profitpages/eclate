{{ 'section-ingredients.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign arts = 'swatch,serum,jar,pump,tube,compact' | split: ',' -%}
{%- assign tones = 'lilac,peach,sand,blush,lilac,peach' | split: ',' -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
    {%- if s.use_metafield and product and product.metafields.custom.ingredients != blank -%}
      <div class="ingredients__full rte">{{ product.metafields.custom.ingredients | metafield_tag }}</div>
    {%- endif -%}
    <ul class="ingredients ingredients--{{ s.style }}" role="list" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign ai = forloop.index0 | modulo: 6 -%}
        <li class="ingredient" data-reveal {{ block.shopify_attributes }}>
          <div class="ingredient__media">
            {%- render 'responsive-image', image: b.image, max: 700, sizes: '(min-width: 990px) 24vw, 46vw', class: 'ingredient__img', art: arts[ai], tone: tones[ai] -%}
            {%- if b.benefit != blank -%}<span class="ingredient__tag">{{ b.benefit | escape }}</span>{%- endif -%}
          </div>
          <div class="ingredient__body">
            <h3 class="ingredient__name">{{ b.name | escape }}</h3>
            {%- if b.text != blank -%}<p class="ingredient__text">{{ b.text | escape }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.ingredients.name",
  "class": "section-ingredients",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.ingredients.settings.kicker.label",
      "default": "Inside the formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.ingredients.settings.heading.label",
      "default": "Good ingredients, beautifully simple."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.ingredients.settings.text.label"
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "t:sections.ingredients.settings.use_metafield.label",
      "default": false,
      "info": "t:sections.ingredients.settings.use_metafield.info"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.ingredients.settings.style.label",
      "options": [
        {
          "value": "soft",
          "label": "t:sections.ingredients.settings.style.options__1.label"
        },
        {
          "value": "lift",
          "label": "t:sections.ingredients.settings.style.options__2.label"
        }
      ],
      "default": "soft"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.ingredients.settings.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.ingredients.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:sections.ingredients.blocks.ingredient.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.ingredients.blocks.ingredient.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.ingredients.blocks.ingredient.settings.name.label",
          "default": "Hyaluronic acid"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.ingredients.blocks.ingredient.settings.text.label",
          "default": "A hydration-loving humectant for a cushiony, dewy feel."
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "t:sections.ingredients.blocks.ingredient.settings.benefit.label",
          "default": "Hydrates"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ingredients.presets.presets__1.name",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Hyaluronic acid",
            "text": "A hydration-loving humectant for a cushiony, dewy feel.",
            "benefit": "Hydrates"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Niacinamide",
            "text": "A versatile favourite for a more balanced-looking complexion.",
            "benefit": "Balances"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Peptides",
            "text": "Skin-conditioning care for a soft, supple finish.",
            "benefit": "Plumps"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Botanical extracts",
            "text": "Plant-inspired accents that make every ritual feel special.",
            "benefit": "Soothes"
          }
        }
      ]
    },
    {
      "name": "t:sections.ingredients.presets.presets__2.name",
      "settings": {
        "kicker": "Formula intelligence",
        "heading": "High-performance care, made soft enough for every day.",
        "style": "lift",
        "columns": 3,
        "color_scheme": "scheme-5"
      },
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Peptide complex",
            "text": "A precise blend that supports the look of springy, resilient skin.",
            "benefit": "Firms"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hyaluronic acid",
            "text": "Three molecular weights cushion skin with long-lasting hydration.",
            "benefit": "Hydrates"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin C",
            "text": "A gentle brightening antioxidant for a more even, lit-from-within finish.",
            "benefit": "Brightens"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} Shop by concern — the beauty equivalent of "shop by age". Arch tiles with soft icon orbs. {%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  {%- render 'decor', preset: 'corner' -%}
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <ul class="concerns" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign url = b.link | default: b.collection.url | default: routes.all_products_collection_url -%}
        <li class="concern" data-reveal style="--tint: {{ b.tint }};" {{ block.shopify_attributes }}>
          <a class="concern__link" href="{{ url }}">
            <span class="concern__orb">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', width: 120, height: 120, class: 'concern__img' }}
              {%- else -%}
                {%- render 'icon', name: b.icon, size: 30 -%}
              {%- endif -%}
            </span>
            <span class="concern__title">{{ b.title | escape }}</span>
            {%- if b.text != blank -%}<span class="concern__text">{{ b.text | escape }}</span>{%- endif -%}
            <span class="concern__go" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 16 %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop-by-concern.name",
  "class": "section-concerns",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.shop-by-concern.settings.kicker.label",
      "default": "Start with your skin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shop-by-concern.settings.heading.label",
      "default": "Shop by concern"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shop-by-concern.settings.text.label",
      "default": "<p>Tell us what your skin is asking for — we'll show you the rituals made for it.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shop-by-concern.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "t:sections.shop-by-concern.blocks.concern.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.title.label",
          "default": "Dryness"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.text.label",
          "default": "Cushion & comfort"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.label",
          "options": [
            {
              "value": "drop",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__1.label"
            },
            {
              "value": "sun",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__2.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__3.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__4.label"
            },
            {
              "value": "moon",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__5.label"
            },
            {
              "value": "flower",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__6.label"
            },
            {
              "value": "shield",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__7.label"
            },
            {
              "value": "heart",
              "label": "t:sections.shop-by-concern.blocks.concern.settings.icon.options__8.label"
            }
          ],
          "default": "drop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.image.label",
          "info": "t:sections.shop-by-concern.blocks.concern.settings.image.info"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.link.label",
          "info": "t:sections.shop-by-concern.blocks.concern.settings.link.info"
        },
        {
          "type": "color",
          "id": "tint",
          "label": "t:sections.shop-by-concern.blocks.concern.settings.tint.label",
          "default": "#efd1cf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop-by-concern.presets.presets__1.name",
      "blocks": [
        {
          "type": "concern",
          "settings": {
            "title": "Dryness",
            "text": "Cushion & comfort",
            "icon": "drop",
            "tint": "#d9e4ef"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Dullness",
            "text": "Bring back the glow",
            "icon": "sun",
            "tint": "#f5e3c2"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Fine lines",
            "text": "Bounce & smooth",
            "icon": "sparkle",
            "tint": "#ded0ea"
          }
        },
        {
          "type": "concern",
          "settings": {

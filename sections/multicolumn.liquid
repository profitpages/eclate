{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign arts = 'serum,jar,compact,pump,tube,lipstick' | split: ',' -%}
{%- assign tones = 'blush,lilac,peach,sand,blush,lilac' | split: ',' -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="mcol mcol--{{ s.style }} mcol--{{ s.text_align }}{% if s.swipe %} mcol--swipe{% endif %}" role="list" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        <li class="mcol__item" data-reveal {{ block.shopify_attributes }}>
          <div class="mcol__media mcol__media--{{ s.shape }}">
            {%- render 'responsive-image', image: b.image, max: 900, sizes: '(min-width: 990px) 30vw, 80vw', class: 'mcol__img', art: arts[i], tone: tones[i] -%}
          </div>
          <div class="mcol__body">
            {%- if b.title != blank -%}<h3 class="mcol__title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="rte mcol__text">{{ b.text }}</div>{%- endif -%}
            {%- if b.link_label != blank -%}<a class="link-underline" href="{{ b.link | default: routes.all_products_collection_url }}">{{ b.link_label | escape }} {% render 'icon', name: 'arrow-right', size: 15 %}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.button_label != blank -%}<div class="btn-row btn-row--center mcol__cta">{%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section-multicolumn",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.multicolumn.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading.label",
      "default": "Rituals for every moment."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.multicolumn.settings.text.label"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.multicolumn.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.heading_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.multicolumn.settings.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.multicolumn.settings.style.label",
      "options": [
        {
          "value": "card",
          "label": "t:sections.multicolumn.settings.style.options__1.label"
        },
        {
          "value": "open",
          "label": "t:sections.multicolumn.settings.style.options__2.label"
        }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "t:sections.multicolumn.settings.shape.label",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.multicolumn.settings.shape.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.shape.options__2.label"
        },
        {
          "value": "arch",
          "label": "t:sections.multicolumn.settings.shape.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.shape.options__4.label"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.multicolumn.settings.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.text_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "swipe",
      "label": "t:sections.multicolumn.settings.swipe.label",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multicolumn.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label",
          "default": "Morning"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label",
          "default": "<p>Light layers and SPF for a fresh, protected glow.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label.label",
          "default": "Shop AM"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.presets__1.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column",
          "settings": {
            "title": "Evening",
            "text": "<p>Richer textures that replenish while you rest.</p>",
            "link_label": "Shop PM"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "On the go",
            "text": "<p>Minis and balms for a glow between meetings.</p>",
            "link_label": "Shop minis"
          }
        }
      ]
    }
  ]
}
{% endschema %}

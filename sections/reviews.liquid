{%- comment -%}
  Reviews — integration point for review apps. Never invents reviews:
  • App block(s) render the real review widget (breakdown + review cards).
  • Rating summary reads the standard reviews.rating / reviews.rating_count metafields.
  • With no app and no data, nothing shows to shoppers; merchants see a setup hint in the editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
  assign r = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if has_app or r != blank or request.design_mode -%}
  <section class="section color-{{ s.color_scheme }}" id="reviews">
    <div class="page-width">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading -%}
      <div class="reviews{% if r != blank %} reviews--with-summary{% endif %}">
        {%- if r != blank -%}
          {%- assign avg = r.rating | round: 1 -%}
          {%- assign pct = r.rating | divided_by: r.scale_max | times: 100 -%}
          <aside class="reviews__summary color-{{ s.summary_scheme }}">
            <p class="reviews__score">{{ avg }}</p>
            <span class="rating__stars rating__stars--lg" style="--pct: {{ pct }}%;" aria-hidden="true">★★★★★</span>
            <p class="reviews__count">{{ 'products.based_on' | t: count: count }}</p>
            <span class="visually-hidden">{{ 'products.rating' | t: rating: avg, max: r.scale_max }}</span>
          </aside>
        {%- endif -%}
        <div class="reviews__app">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
          {%- if has_app == false and request.design_mode -%}
            <div class="setup-hint">
              {%- render 'icon', name: 'star', size: 20 -%}
              <p><strong>{{ 'sections.reviews_hint_title' | t }}</strong><br>{{ 'sections.reviews_hint' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "class": "section-reviews",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Loved in real life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Soft skin, loud praise." },
    { "type": "color_scheme", "id": "summary_scheme", "label": "Summary card color scheme", "default": "scheme-4" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section color scheme", "default": "scheme-2" },
    { "type": "paragraph", "content": "Install a reviews app and add its block here. The rating summary reads the reviews metafields that apps write automatically." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}

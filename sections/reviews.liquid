{%- comment -%}
  Reviews. Never invents reviews. Two sources, both real:
  • Profit Pages reviews (product.metafields.profitpages.reviews): rendered
    here in Éclaté's design, "More reviews" pages through the rest.
  • Any other review app: its app block renders inside .reviews__app.
  The rating summary reads the standard reviews.rating / reviews.rating_count
  metafields, which Profit Pages and review apps write. With no data, shoppers
  see nothing; merchants see a setup hint in the editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
  assign r = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
  assign addons = shop.metafields.profitpages.addons.value
  assign pp = product.metafields.profitpages.reviews.value
  assign has_pp = false
  if addons.active and pp.items.size > 0
    assign has_pp = true
  endif
-%}
{%- if has_app or has_pp or r != blank or request.design_mode -%}
  <section class="section color-{{ s.color_scheme }}" id="reviews">
    <div class="page-width">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading -%}
      <div class="reviews{% if r != blank %} reviews--with-summary{% endif %}">
        {%- if r != blank -%}
          {%- assign avg = r.rating | round: 1 -%}
          {%- assign pct = r.rating | divided_by: r.scale_max | times: 100 -%}
          <aside class="reviews__summary color-{{ s.summary_scheme }}">
            <p class="reviews__score">{{ avg }}</p>
            <span class="rating__stars rating__stars--lg" style="--pct: {{ pct }}%;" aria-hidden="true">★★★★★</span>
            <p class="reviews__count">{{ 'products.based_on' | t: count: count }}</p>
            <span class="visually-hidden">{{ 'products.rating' | t: rating: avg, max: r.scale_max }}</span>
          </aside>
        {%- endif -%}
        <div class="reviews__app">
          {%- if has_pp -%}
            <div class="pp-reviews" data-pp-reviews data-product-id="{{ product.id }}">
              <div class="pp-reviews__list" data-pp-reviews-list>
                {%- for item in pp.items -%}{%- render 'pp-review-card', review: item -%}{%- endfor -%}
              </div>
              <template data-pp-review-template>{%- render 'pp-review-card', review: blank -%}</template>
              {%- if pp.count > pp.items.size -%}
                <button type="button" class="btn btn--outline btn--sm pp-reviews__more" data-pp-reviews-more>{{ 'addons.reviews_more' | t }}</button>
              {%- endif -%}
              {%- if pp.disclosure != blank -%}<p class="pp-reviews__note muted">{{ pp.disclosure | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
          {%- if has_app == false and has_pp == false and request.design_mode -%}
            <div class="setup-hint">
              {%- render 'icon', name: 'star', size: 20 -%}
              <p><strong>{{ 'sections.reviews_hint_title' | t }}</strong><br>{{ 'sections.reviews_hint' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.reviews.name",
  "class": "section-reviews",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.reviews.settings.kicker.label",
      "default": "Loved in real life"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.reviews.settings.heading.label",
      "default": "Soft skin, loud praise."
    },
    {
      "type": "color_scheme",
      "id": "summary_scheme",
      "label": "t:sections.reviews.settings.summary_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.reviews.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "paragraph",
      "content": "t:sections.reviews.settings.paragraph__5.content"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews.presets.presets__1.name"
    }
  ]
}
{% endschema %}

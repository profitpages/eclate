{%- comment -%} Collection banner — uses the collection's title, description and image by default. {%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign title = s.heading
  assign desc = s.text
  assign bg_img = s.background_image
  assign frame_img = s.image
  if collection
    assign title = collection.title
    if collection.description != blank
      assign desc = collection.description
    endif
    if frame_img == blank
      assign frame_img = collection.image
    endif
  elsif request.page_type == 'search'
    assign title = 'search.title' | t
  endif
-%}
<section class="coll-hero-wrap color-{{ s.section_scheme }}">
  <div class="page-width">
    {%- if s.show_breadcrumb -%}{%- render 'breadcrumb' -%}{%- endif -%}
    <div class="coll-hero color-{{ s.color_scheme }}">
      {%- if bg_img != blank -%}
        <div class="coll-hero__bg">{%- render 'responsive-image', image: bg_img, max: 2000, sizes: '100vw', class: 'coll-hero__bg-img', eager: true -%}</div>
      {%- endif -%}
      {%- render 'decor', preset: 'band' -%}
      <div class="coll-hero__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        <h1 class="display coll-hero__title">{{ title | escape }}</h1>
        {%- if desc != blank -%}<div class="rte coll-hero__text">{{ desc }}</div>{%- endif -%}
        {%- if s.show_count and collection -%}<p class="coll-hero__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>{%- endif -%}
      </div>
      {%- if s.show_art -%}
        <div class="coll-hero__art" aria-hidden="true">
          <span class="coll-hero__sun float-y"></span>
          <div class="coll-hero__frame">
            {%- render 'responsive-image', image: frame_img, max: 800, sizes: '(min-width: 990px) 300px, 220px', eager: true, art: 'serum', tone: 'peach' -%}
          </div>
          {%- if s.pill != blank -%}<span class="coll-hero__pill">{{ s.pill | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-hero.name",
  "class": "section-collection-hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection-hero.settings.kicker.label",
      "default": "The complete edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-hero.settings.heading.label",
      "default": "Beauty, considered."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.collection-hero.settings.text.label",
      "default": "<p>Skin-loving colour, care, and sensorial formulas designed to turn your everyday into a small, beautiful ritual.</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.collection-hero.settings.background_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_art",
      "label": "t:sections.collection-hero.settings.show_art.label",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.collection-hero.settings.image.label",
      "info": "t:sections.collection-hero.settings.image.info"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "t:sections.collection-hero.settings.pill.label",
      "default": "Ritual ready"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection-hero.settings.show_count.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.collection-hero.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-hero.settings.color_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "section_scheme",
      "label": "t:sections.collection-hero.settings.section_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-hero.presets.presets__1.name"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Before / after comparison slider — accessible range input drives the reveal (works with keyboard & touch).
{%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  {%- render 'decor', preset: 'corner' -%}
  <div class="page-width ba-grid{% if s.layout == 'stacked' %} ba-grid--stacked{% endif %}">
    <div class="ba-copy">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
      {%- if s.disclaimer != blank -%}<p class="ba-note">{{ s.disclaimer | escape }}</p>{%- endif -%}
      {%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}
    </div>
    <before-after class="ba" style="--pos: {{ s.start }}%;">
      <div class="ba__frame">
        <div class="ba__img ba__img--after">
          {%- render 'responsive-image', image: s.after, max: 1400, sizes: '(min-width: 990px) 50vw, 92vw', art: 'swatch', tone: 'peach' -%}
          <span class="ba__tag ba__tag--after glass">{{ s.after_label | escape }}</span>
        </div>
        <div class="ba__img ba__img--before" aria-hidden="true">
          {%- render 'responsive-image', image: s.before, max: 1400, sizes: '(min-width: 990px) 50vw, 92vw', art: 'swatch', tone: 'sand' -%}
          <span class="ba__tag glass">{{ s.before_label | escape }}</span>
        </div>
        <span class="ba__handle" aria-hidden="true"><span class="ba__knob glass">{% render 'icon', name: 'arrow-left', size: 14 %}{% render 'icon', name: 'arrow-right', size: 14 %}</span></span>
        <label class="visually-hidden" for="BA-{{ section.id }}">{{ 'sections.compare_label' | t }}</label>
        <input class="ba__range" id="BA-{{ section.id }}" type="range" min="0" max="100" value="{{ s.start }}" data-ba-range>
      </div>
    </before-after>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.before-after.name",
  "class": "section-before-after",
  "settings": [
    {
      "type": "image_picker",
      "id": "before",
      "label": "t:sections.before-after.settings.before.label"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "t:sections.before-after.settings.after.label",
      "info": "t:sections.before-after.settings.after.info"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "t:sections.before-after.settings.before_label.label",
      "default": "Day 1"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "t:sections.before-after.settings.after_label.label",
      "default": "Week 4"
    },
    {
      "type": "range",
      "id": "start",
      "label": "t:sections.before-after.settings.start.label",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.before-after.settings.kicker.label",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.before-after.settings.heading.label",
      "default": "Four weeks of luminous."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.before-after.settings.text.label",
      "default": "<p>Drag to see how skin looked before and after a month of the ritual.</p>"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:sections.before-after.settings.disclaimer.label",
      "default": "Unretouched images. Individual results vary."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.before-after.settings.button_label.label",
      "default": "Shop the ritual"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.before-after.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.before-after.settings.layout.label",
      "options": [
        {
          "value": "side",
          "label": "t:sections.before-after.settings.layout.options__1.label"
        },
        {
          "value": "stacked",
          "label": "t:sections.before-after.settings.layout.options__2.label"
        }
      ],
      "default": "side"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.before-after.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:sections.before-after.presets.presets__1.name"
    }
  ]
}
{% endschema %}

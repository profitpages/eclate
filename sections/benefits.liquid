{%- comment -%} Benefits / Key benefits — soft panel with frosted feature cards. Used on home and product pages. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="{% if s.style == 'panel' %}panel color-{{ s.color_scheme }}{% endif %} benefits benefits--{{ s.style }}">
      {%- if s.style == 'panel' -%}{%- render 'decor', preset: 'corner' -%}{%- endif -%}
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
      <ul class="feature-grid" role="list" style="--cols: {{ s.columns }};">
        {%- for block in section.blocks -%}
          <li class="feature glass-soft" data-reveal {{ block.shopify_attributes }}>
            <span class="feature__icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 28, height: 28 }}
              {%- else -%}
                {%- render 'icon', name: block.settings.icon, size: 22 -%}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="feature__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="feature__text rte">{{ block.settings.text }}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "class": "section-benefits",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Good things, softly formulated" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "High-performance rituals with a tender touch." },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "style", "label": "Style",
      "options": [{ "value": "panel", "label": "Soft panel" }, { "value": "open", "label": "Open cards" }, { "value": "pills", "label": "Compact pills" }],
      "default": "panel"
    },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-3" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Glow" }, { "value": "drop", "label": "Hydration" }, { "value": "leaf", "label": "Botanical" },
            { "value": "flower", "label": "Flower" }, { "value": "sun", "label": "Brightening" }, { "value": "moon", "label": "Overnight" },
            { "value": "shield", "label": "Barrier / tested" }, { "value": "rabbit", "label": "Cruelty-free" }, { "value": "recycle", "label": "Recyclable" },
            { "value": "flask", "label": "Clinical" }, { "value": "clock", "label": "Long-lasting" }, { "value": "heart", "label": "Gentle" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Visible glow" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Light-catching finishes designed for an effortlessly rested look.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "sparkle", "title": "Visible glow", "text": "<p>Light-catching finishes designed for an effortlessly rested look.</p>" } },
        { "type": "benefit", "settings": { "icon": "drop", "title": "Lasting comfort", "text": "<p>Cushiony textures that support skin through every season.</p>" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Thoughtfully made", "text": "<p>Botanical ingredients and recyclable presentation materials.</p>" } }
      ]
    },
    {
      "name": "Key benefits",
      "settings": { "kicker": "Why it works", "heading": "Key benefits", "style": "pills", "columns": 5, "section_scheme": "scheme-1" },
      "blocks": [
        { "type": "benefit", "settings": { "icon": "drop", "title": "Hydrating", "text": "" } },
        { "type": "benefit", "settings": { "icon": "sun", "title": "Brightening", "text": "" } },
        { "type": "benefit", "settings": { "icon": "flower", "title": "Nourishing", "text": "" } },
        { "type": "benefit", "settings": { "icon": "sparkle", "title": "Lightweight", "text": "" } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "Long-lasting", "text": "" } }
      ]
    }
  ]
}
{% endschema %}
